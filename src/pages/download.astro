---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const platforms = [
  { name: "Windows", detail: "Windows 10/11 · x64" },
  { name: "Linux", detail: "AppImage · x86_64" },
  { name: "macOS", detail: "Apple silicon and Intel" },
];
---
<SiteLayout title="Download saGraph">
  <Header /><main class="container page"><p class="eyebrow">Download</p><h1>Put your workflows somewhere close.</h1><p class="intro">Choose your platform. Every release is signed and verified before it can be installed by the app.</p><div class="platform-grid">{platforms.map((platform) => <article class="card platform"><div><span class="platform-symbol">{platform.name.slice(0, 1)}</span><h2>{platform.name}</h2><p>{platform.detail}</p></div><span class="button button-ghost disabled">Coming soon</span></article>)}</div><div class="download-note card"><strong>Downloads are being prepared.</strong><span>Connect the release API and R2 bucket before publishing installer links. Deployment details are documented in the project README.</span></div></main><Footer />
</SiteLayout>
<style>
  .page { padding: 7rem 0 2rem; }.page h1 { font-size: clamp(3rem, 7vw, 6rem); letter-spacing: -0.08em; line-height: 0.96; margin: 1rem 0 1.4rem; max-width: 800px; }.intro { color: var(--muted); font-size: 1.05rem; line-height: 1.7; max-width: 570px; }.platform-grid { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); margin-top: 4rem; }.platform { display: flex; flex-direction: column; justify-content: space-between; min-height: 270px; padding: 1.6rem; }.platform-symbol { align-items: center; background: var(--panel-soft); border-radius: 12px; color: var(--accent); display: inline-flex; font-weight: 800; height: 38px; justify-content: center; width: 38px; }.platform h2 { margin: 1.8rem 0 0.4rem; }.platform p { color: var(--muted); font-size: 0.85rem; }.platform .button { align-self: flex-start; margin-top: 2rem; }.disabled { cursor: not-allowed; opacity: 0.55; }.download-note { color: var(--muted); display: flex; flex-direction: column; gap: 0.4rem; line-height: 1.6; margin-top: 1rem; padding: 1.2rem 1.4rem; }.download-note strong { color: var(--text); }
  @media (max-width: 800px) { .platform-grid { grid-template-columns: 1fr; } }
</style>
