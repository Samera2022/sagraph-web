---
import "../styles/global.css";

interface Props { title?: string; description?: string; }
const { title = "saGraph — dependency-aware workflows", description = "A quiet desktop task panel for workflows that depend on each other." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
