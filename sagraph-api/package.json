{
  "name": "sagraph-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply sagraph-commerce --local",
    "db:migrate:remote": "wrangler d1 migrations apply sagraph-commerce --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
