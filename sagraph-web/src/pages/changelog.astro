---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const entries = (await getCollection("changelog")).sort((a, b) => b.data.version.localeCompare(a.data.version, undefined, { numeric: true }));
---
<SiteLayout title="Changelog — saGraph"><Header /><main class="container page"><p class="eyebrow">Changelog</p><h1>What changed.</h1><p class="intro">A clear record of every release, kept in sync with the desktop updater.</p><div class="entries">{entries.map((entry) => <article class="entry"><div class="entry-meta"><strong>v{entry.data.version}</strong><time>{entry.data.date}</time></div><div><h2>{entry.data.title}</h2><p class="summary">{entry.data.summary}</p><ul>{entry.data.highlights.map((highlight) => <li>{highlight}</li>)}</ul></div></article>)}</div></main><Footer /></SiteLayout>
<style>
  .page { padding: 7rem 0 2rem; }.page h1 { font-size: clamp(3.2rem, 7vw, 6rem); letter-spacing: -0.045em; line-height: 0.96; margin: 1rem 0 1.4rem; }.intro { color: var(--muted); font-size: 1.05rem; line-height: 1.7; max-width: 570px; }.entries { border-top: 1px solid var(--line); margin-top: 5rem; }.entry { display: grid; gap: 3rem; grid-template-columns: 150px 1fr; padding: 2.6rem 0; border-bottom: 1px solid var(--line); }.entry-meta { display: flex; flex-direction: column; gap: 0.45rem; }.entry-meta strong { color: var(--accent); font-size: 1.1rem; }.entry-meta time { color: var(--muted); font-size: 0.78rem; }.entry h2 { font-size: 1.5rem; margin: 0 0 0.6rem; }.summary, li { color: var(--muted); line-height: 1.7; }.entry ul { padding-left: 1.2rem; }
  @media (max-width: 600px) { .entry { gap: 1rem; grid-template-columns: 1fr; } }
</style>
