---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const entries = (await getCollection("changelog")).sort((a, b) => b.data.version.localeCompare(a.data.version, undefined, { numeric: true }));
import ChangelogPanel from "../components/ChangelogPanel.svelte";
---
<SiteLayout title="Changelog — saGraph"><Header /><main class="container page"><p class="eyebrow">Changelog</p><h1>What changed.</h1><p class="intro">A clear record of every release, loaded from the published release catalog.</p><ChangelogPanel client:load fallbackEntries={entries.map((entry) => entry.data)} /></main><Footer /></SiteLayout>
<style>
  .page { padding: 7rem 0 2rem; }.page h1 { font-size: clamp(3.2rem, 7vw, 6rem); letter-spacing: -0.045em; line-height: 0.96; margin: 1rem 0 1.4rem; }.intro { color: var(--muted); font-size: 1.05rem; line-height: 1.7; max-width: 570px; }
</style>
