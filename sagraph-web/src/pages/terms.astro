---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<SiteLayout title="Terms — saGraph"><Header /><main class="container legal"><p class="eyebrow">Legal</p><h1>Terms</h1><p class="muted">This page is a placeholder for the production terms of service. Define licensing, permitted use, subscriptions, refunds, updates, account termination, support, and limitation of liability before launch.</p></main><Footer /></SiteLayout>
<style>.legal { max-width: 760px; padding: 7rem 0 2rem; }.legal h1 { font-size: 4rem; letter-spacing: -0.08em; }.legal p { font-size: 1rem; line-height: 1.8; }</style>
