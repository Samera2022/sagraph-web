---
import SiteLayout from "../layouts/SiteLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<SiteLayout title="Privacy — saGraph"><Header /><main class="container legal"><p class="eyebrow">Legal</p><h1>Privacy</h1><p class="muted">This page is a placeholder for the production privacy policy. Before accepting payments or collecting account data, publish a policy covering accounts, licenses, device identifiers, update checks, analytics, cookies, retention, and deletion requests.</p></main><Footer /></SiteLayout>
<style>.legal { max-width: 760px; padding: 7rem 0 2rem; }.legal h1 { font-size: 4rem; letter-spacing: -0.045em; }.legal p { font-size: 1rem; line-height: 1.8; }</style>
